[Unit]
Description=Answerr Reflex Decision Engine Production REST API (werr 0-VRAM)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/apps/answerr/api
ExecStart=/opt/apps/answerr/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8560 --workers 4
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
